# Ambient: ortam değişkenleri. Yalnız önyükleme için (docs/ADMIN.md §2); diğer her ayar yönetim panelinden yapılır.
# Gerçek değerleri .env dosyasına yaz; .env repoya girmez.

APP_ENV=local                 # local | staging | production (panelde ortam şeridi)
DATABASE_URL=postgresql://ambient:ambient@localhost:5432/ambient
REDIS_URL=redis://localhost:6379
SETTINGS_MASTER_KEY=          # 32 bayt, base64: veritabanındaki sırları şifreler; veritabanıyla aynı yerde tutma, yedekle
ADMIN_BOOTSTRAP_EMAIL=        # ilk superadmin; ilk girişten sonra etkisizdir
PORT=3000                     # isteğe bağlı

# Mobil derleme zamanı (EAS profilinde): EXPO_PUBLIC_API_URL=http://localhost:3000
# API anahtarları, model, bütçe, kur, komisyon, SMTP, OAuth, Sentry, JWT anahtarları: panelde (Ayarlar → Entegrasyonlar, Maliyet ve politika).

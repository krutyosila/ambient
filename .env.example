# Ambient: ortam değişkenleri örneği. Gerçek değerleri .env dosyasına yaz; .env repoya girmez.

# --- Genel ---
NODE_ENV=development
APP_ENV=local                 # local | staging | production
API_PORT=3000
TZ=UTC

# --- Veritabanı ve kuyruk ---
DATABASE_URL=postgresql://ambient:ambient@localhost:5432/ambient
REDIS_URL=redis://localhost:6379

# --- Kimlik doğrulama ---
JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me
MAGIC_LINK_BASE_URL=http://localhost:3000
MAIL_FROM=Ambient <no-reply@example.com>
SMTP_URL=                     # magic link için e-posta gönderimi (yerelde Mailpit/benzeri)
APPLE_CLIENT_ID=
GOOGLE_CLIENT_ID=

# --- Yapay zekâ (Anthropic) ---
ANTHROPIC_API_KEY=
LLM_PROVIDER=anthropic
LLM_PRIMARY_MODEL=claude-haiku-5-5          # varsayılan niyet çıkarma
LLM_ESCALATION_MODEL=claude-sonnet-5-5      # yalnız Plus/Pro, zor cümleler
LLM_PRIMARY_EFFORT=low
LLM_MAX_OUTPUT_TOKENS=400

# --- Maliyet politikası (docs/COST-POLICY.md) ---
COMMISSION_RATE=0.30          # Small Business onaylanana dek %30 (plan B)
FX_TRY_PER_USD=55             # referans kur; günlük işle güncellenir
BUDGET_RATIO=0.30             # abone başına bütçe = net gelirin %30'u
BUDGET_FREE_USD=0.04
BUDGET_PLUS_MIN_USD=0.12
BUDGET_PLUS_MAX_USD=0.40
BUDGET_PRO_MIN_USD=0.25
BUDGET_PRO_MAX_USD=0.80
GLOBAL_DAILY_SPEND_CAP_USD=5  # staging için düşük tutulur; aşılırsa Normal katman yerel moda geçer
LLM_KILL_SWITCH=false

# --- Hata izleme (isteğe bağlı; boşsa kapalı) ---
SENTRY_DSN=

# --- Admin ---
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_SESSION_SECRET=change-me

# --- Mobil (Expo) ---
EXPO_PUBLIC_API_URL=http://localhost:3000

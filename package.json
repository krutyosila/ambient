    "tokens": "pnpm --filter @ambient/design-tokens generate"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
